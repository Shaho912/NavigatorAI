# ── Core AI ──────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google (Gmail + Calendar) ────────────────────────────────────────────────
# Steps to get these:
# 1. Go to console.cloud.google.com → New project
# 2. Enable Gmail API and Google Calendar API
# 3. Create OAuth 2.0 credentials (Desktop App type)
# 4. Run: python utils/google_auth.py  — it will open a browser and print your refresh token
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# ── Twilio (SMS confirmations) ────────────────────────────────────────────────
# Get from console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+15005550006
USER_PHONE_NUMBER=+12125551234

# ── ElevenLabs Conversational AI (outbound calls) ────────────────────────────
# ELEVENLABS_AGENT_ID   — from elevenlabs.io → Conversational AI → your agent → Agent ID
# ELEVENLABS_PHONE_NUMBER_ID — from elevenlabs.io → Conversational AI → Phone Numbers → ID column
#                              (NOT the actual phone number — the internal ID ElevenLabs assigns)
# RASHID_PHONE_NUMBER   — the number to call, E.164 format e.g. +12125551234
ELEVENLABS_AGENT_ID=your_agent_id_here
ELEVENLABS_PHONE_NUMBER_ID=your_phone_number_id_here
RASHID_PHONE_NUMBER=+12125551234

# ── Composio (Gmail via Composio) ────────────────────────────────────────────
# 1. Sign up at app.composio.dev
# 2. Connect Gmail under Integrations
# 3. Copy your API key and set an external_user_id (any string, e.g. "rashid")
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_USER_ID=your_composio_user_id_here

# ── Optional ──────────────────────────────────────────────────────────────────
ARA_API_KEY=your_ara_api_key_here
